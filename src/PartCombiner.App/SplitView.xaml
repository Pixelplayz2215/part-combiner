<UserControl x:Class="PartCombiner.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What to split -->
        <Grid Margin="0,20,0,0">
            <!-- Nothing chosen yet: a drop zone like the Combine view's -->
            <Grid Height="150" Visibility="{Binding HasNoSource, Converter={StaticResource BoolToVis}}">
                <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="4 3"
                           Stroke="{DynamicResource Brush.BorderStrong}" Fill="{DynamicResource Brush.Surface}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Drop a file or folder to split" FontFamily="{StaticResource Font.Display}" FontSize="16"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Click="OnChooseFile" AutomationProperties.Name="Choose file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Choose file" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Click="OnChooseFolder" Margin="8,0,0,0" AutomationProperties.Name="Choose folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Choose folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Chosen: a card like the ones in the Combine list -->
            <Border Style="{StaticResource Card}" Padding="14,12,10,12"
                    Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.SurfaceHover}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding SourceGlyph}" FontSize="17"
                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Source}" />
                        <TextBlock Text="{Binding SourceDetails}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextFaint}" ToolTip="{Binding Source}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                        <Button Style="{StaticResource Button.Ghost}" Content="Change file" Click="OnChooseFile" />
                        <Button Style="{StaticResource Button.Ghost}" Content="Folder" Click="OnChooseFolder" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- How to split -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14,18,16" IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Parts" Style="{StaticResource Text.Label}" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Button.Secondary}" Content="&#xE738;" FontFamily="{StaticResource Font.Icons}"
                            FontSize="11" Width="34" Height="34" Padding="0" Click="OnFewer" ToolTip="Fewer parts" AutomationProperties.Name="Fewer parts" />
                    <TextBox x:Name="PartsBox" Grid.Column="1" AutomationProperties.Name="Number of parts" Style="{StaticResource Input.Text}" Width="86" Margin="6,0" TextAlignment="Center"
                             Text="{Binding PartsText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnPartsKey" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="&#xE710;" FontFamily="{StaticResource Font.Icons}"
                            FontSize="11" Width="34" Height="34" Padding="0" Click="OnMore" ToolTip="More parts" AutomationProperties.Name="More parts" />
                    <TextBlock Grid.Column="3" Text="{Binding Preview}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock Grid.Row="1" Text="Names" Style="{StaticResource Text.Label}" Margin="0,16,0,0" VerticalAlignment="Top" />
                <ItemsControl Grid.Row="1" Grid.Column="1" Margin="-12,8,0,0" ItemsSource="{Binding Styles}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Choice}" GroupName="SplitStyle" Margin="0,0,0,2" AutomationProperties.Name="{Binding Title}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <Border Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="4" Padding="5,0"
                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsArchive, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Packed with 7-Zip first (compressed), so it needs 7-Zip">
                                            <TextBlock Text="7-Zip" FontSize="10.5" Foreground="{DynamicResource Brush.TextFaint}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Example}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Example}" />
                                </Grid>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="Password" Style="{StaticResource Text.Label}" Margin="0,14,0,0" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- PasswordBox while hidden, a TextBox showing the same text while revealed -->
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource Input.Password}" PasswordChanged="OnPasswordChanged"
                                 AutomationProperties.Name="Password" />
                    <TextBox x:Name="PasswordShown" Style="{StaticResource Input.Text}" Visibility="Collapsed"
                             TextChanged="OnPasswordShownChanged" AutomationProperties.Name="Password (shown)" />
                    <TextBlock x:Name="PasswordHint" Text="Optional" IsHitTestVisible="False" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextFaint}" />
                    <ToggleButton x:Name="RevealPassword" Grid.Column="1" Margin="4,0,0,0" Width="30" Height="30"
                                  FontFamily="{StaticResource Font.Icons}" FontSize="13" Content="&#xE7B3;" Cursor="Hand"
                                  ToolTip="Show the password" AutomationProperties.Name="Show password"
                                  Checked="OnRevealChanged" Unchecked="OnRevealChanged" Focusable="True">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root" CornerRadius="8" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Grid.Column="2" Text="{Binding PasswordHint}" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextFaint}" />
                </Grid>

                <TextBlock Grid.Row="3" Text="Save to" Style="{StaticResource Text.Label}" Margin="0,14,0,0" />
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="8" BorderThickness="1" Padding="11,0" Height="34" Background="{DynamicResource Brush.Input}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}">
                        <TextBlock Text="{Binding OutputFolderDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding OutputFolderDisplay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomOutput}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Change…" Margin="8,0,0,0"
                            Padding="14,0" Height="34" Click="OnChangeOutput" />
                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE7A7;" Margin="4,0,0,0"
                            ToolTip="Save next to the original again" Click="OnResetOutput"
                            Visibility="{Binding HasCustomOutput, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Switch}" Margin="0,16,0,0"
                          Content="Write a .crc file so joining can be checked"
                          IsChecked="{Binding WriteCrc}" IsEnabled="{Binding CrcAvailable}"
                          ToolTip="A small Total Commander style .crc file with the original name, size and CRC32.&#x0a;Part Combiner uses it to verify the joined file. (Archives check themselves.)" />
            </Grid>
        </Border>

        <!-- Footer: status, progress, actions -->
        <Grid Grid.Row="3" Margin="2,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="12.5" ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Style="{StaticResource Progress.Thin}" Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                             Margin="0,9,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Secondary}" Content="Show parts" Margin="0,0,8,0" Click="OnReveal"
                        Visibility="{Binding CanReveal, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,8,0" Click="OnCancel"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Button.Primary}" Content="Split" MinWidth="124"
                        IsEnabled="{Binding CanSplit}" Click="OnSplit" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
