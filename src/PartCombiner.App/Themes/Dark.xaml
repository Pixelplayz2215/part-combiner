<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Bg">#111214</Color>
    <Color x:Key="Color.Text">#EDEDEF</Color>
    <Color x:Key="Color.Border">#2A2C32</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="#111214" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#18191C" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#202125" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#27292E" />
    <SolidColorBrush x:Key="Brush.Input" Color="#131416" />
    <SolidColorBrush x:Key="Brush.Border" Color="#24262B" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#33353C" />

    <SolidColorBrush x:Key="Brush.Text" Color="#EDEDEF" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A0A3AB" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#6C6F78" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#7C7CFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8F8FFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#6B6BEE" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#267C7CFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#3DD68C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F2B544" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF6E6E" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#1CF2B544" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#1CFF6E6E" />

    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="#3A3C44" />
    <SolidColorBrush x:Key="Brush.SwitchKnob" Color="#EDEDEF" />
    <SolidColorBrush x:Key="Brush.SegmentTrack" Color="#111214" />
    <SolidColorBrush x:Key="Brush.SegmentThumb" Color="#2A2C32" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#3A3C44" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#E6111214" />

</ResourceDictionary>
