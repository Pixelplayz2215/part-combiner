<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Bg">#F5F6F8</Color>
    <Color x:Key="Color.Text">#16171B</Color>
    <Color x:Key="Color.Border">#DADDE3</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#F0F1F4" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#E6E8EC" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#D4D7DD" />

    <SolidColorBrush x:Key="Brush.Text" Color="#16171B" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5D616B" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#8D919B" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#5B5BEF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4C4CE2" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3F3FCE" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A5B5BEF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#15994B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B86E00" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D92D2D" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#17B86E00" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#12D92D2D" />

    <SolidColorBrush x:Key="Brush.SwitchTrack" Color="#CDD0D7" />
    <SolidColorBrush x:Key="Brush.SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SegmentTrack" Color="#ECEDF1" />
    <SolidColorBrush x:Key="Brush.SegmentThumb" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C9CCD3" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#EBF5F6F8" />

</ResourceDictionary>
