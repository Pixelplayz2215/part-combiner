<Window x:Class="PartCombiner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PartCombiner"
        Title="Part Combiner"
        Width="760" Height="820" MinWidth="580" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="OnDragOver"
        PreviewDragOver="OnDragOver"
        PreviewDragLeave="OnDragLeave"
        PreviewDrop="OnDrop">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding OverallProgress}" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One card per detected set -->
        <DataTemplate DataType="{x:Type local:PartSetViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12,10,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="42" Height="42" CornerRadius="10" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.SurfaceHover}">
                        <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}" />
                        <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.TextFaint}" TextTrimming="CharacterEllipsis" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" Text="{Binding StatusGlyph}"
                                       FontSize="11.5" Margin="0,1,6,0" Foreground="{DynamicResource Brush.TextMuted}" />
                            <TextBlock x:Name="StatusLine" Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding IssueSummary}"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE838;" ToolTip="Show in folder"
                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="ExpandButton" Style="{StaticResource Button.Icon}" Content="&#xE70D;" ToolTip="Show parts"
                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" ToolTip="Remove from list"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Progress.Thin}"
                                 Value="{Binding Progress, Mode=OneWay}" Margin="54,10,6,0"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="54,12,8,2"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding IssueRows}" Margin="0,0,0,10"
                                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,7" Margin="0,0,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Virtualized so sets with thousands of parts stay fast -->
                        <ItemsControl ItemsSource="{Binding PartRows}" MaxHeight="230"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True" Focusable="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="11.5" Margin="12,0,0,0"
                                                   FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextFaint}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding FolderPath}" FontSize="11.5" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextFaint}" ToolTip="{Binding FolderPath}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusGlyph}" Value="">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ExpandButton" Property="Content" Value="&#xE70E;" />
                    <Setter TargetName="ExpandButton" Property="ToolTip" Value="Hide parts" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:ItemState.Warning}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:ItemState.NeedsEngine}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:ItemState.Blocked}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:ItemState.Failed}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:ItemState.Done}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Margin="28,20,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource Logo}" VerticalAlignment="Center" Focusable="False" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Part Combiner" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Split and rejoin archives and files" Style="{StaticResource Text.Muted}" FontSize="12.5" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Combine / Split -->
                <Border Grid.Row="1" HorizontalAlignment="Left" CornerRadius="8" Padding="3" Margin="0,18,0,0"
                        Background="{DynamicResource Brush.SegmentTrack}" IsEnabled="{Binding CanSwitchMode}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="CombineTab" AutomationProperties.Name="Combine" Style="{StaticResource Segment}" GroupName="Mode" IsChecked="{Binding IsCombineMode}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Combine" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SplitTab" AutomationProperties.Name="Split" Style="{StaticResource Segment}" GroupName="Mode" IsChecked="{Binding IsSplitMode}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Split" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateBadge" Style="{StaticResource Button.PillAccent}" Margin="0,0,8,0"
                        ToolTip="{Binding UpdateTooltip}" Click="OnUpdateClick" IsEnabled="{Binding IsIdle}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding UpdateText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Pill}" VerticalAlignment="Center"
                        ToolTip="{Binding EngineTooltip}" Click="OnEngineClick">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EngineAvailable}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding EngineText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </Grid>

            <!-- Split mode replaces everything below the header -->
            <local:SplitView Grid.Row="1" Grid.RowSpan="3" DataContext="{Binding Split}"
                             Visibility="{Binding DataContext.IsSplitMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

            <!-- Content: empty drop zone or the list of sets -->
            <Grid Grid.Row="1" Margin="0,20,0,0" Visibility="{Binding IsCombineMode, Converter={StaticResource BoolToVis}}">
                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="4 3"
                               Stroke="{DynamicResource Brush.BorderStrong}" Fill="{DynamicResource Brush.Surface}" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Grid Width="60" Height="60" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource Brush.AccentSoft}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="24"
                                       Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Drop split parts here" FontFamily="{StaticResource Font.Display}" FontSize="17"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="or a folder that contains them — the other parts are found automatically"
                                   Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Style="{StaticResource Button.Secondary}" Click="OnBrowseFiles" AutomationProperties.Name="Browse files">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Browse files" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" Click="OnBrowseFolder" Margin="8,0,0,0" AutomationProperties.Name="Browse folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Browse folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text=".part1.rar   .r00   .7z.001   .zip.001   .z01   .001   .part1   .aa   .tar.gz.001"
                                   FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextFaint}" HorizontalAlignment="Center" Margin="0,28,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ListHeader}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Ghost}" Click="OnBrowseFiles">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock Text="Add files" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Click="OnBrowseFolder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Add folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Click="OnClear" IsEnabled="{Binding IsIdle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" Padding="0,0,2,0">
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Options -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14,18,16"
                    Visibility="{Binding IsCombineMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Save to" Style="{StaticResource Text.Label}" />
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" BorderThickness="1" Padding="11,0" Height="34" Background="{DynamicResource Brush.Input}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}">
                            <TextBlock Text="{Binding OutputFolderDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding OutputFolderDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCustomOutput}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="Change…" Margin="8,0,0,0"
                                Padding="14,0" Height="34" Click="OnChangeOutput" />
                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE7A7;" Margin="4,0,0,0"
                                ToolTip="Save next to the parts again" Click="OnResetOutput"
                                Visibility="{Binding HasCustomOutput, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Archives" Style="{StaticResource Text.Label}" Margin="0,12,0,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Border CornerRadius="8" Padding="3" Background="{DynamicResource Brush.SegmentTrack}"
                                ToolTip="For byte-split archives such as .7z.001 or .zip.001. RAR and .z01 volumes are always extracted.">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Extract contents"
                                             IsChecked="{Binding ExtractArchives}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="Keep as archive"
                                             IsChecked="{Binding KeepArchives}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Password" Style="{StaticResource Text.Label}" Margin="0,12,0,0" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource Input.Password}"
                                     PasswordChanged="OnPasswordChanged" />
                        <TextBlock x:Name="PasswordHint" Text="Only for protected archives" IsHitTestVisible="False"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextFaint}" />
                    </Grid>

                    <!-- Each switch carries its own bottom gap so wrapped rows stay evenly spaced. -->
                    <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,-10">
                        <CheckBox Style="{StaticResource Switch}" Content="Move parts to Recycle Bin when done"
                                  IsChecked="{Binding RecycleParts}" Margin="0,0,28,10" />
                        <CheckBox Style="{StaticResource Switch}" Content="Open folder when done"
                                  IsChecked="{Binding OpenFolderWhenDone}" Margin="0,0,28,10" />
                        <CheckBox Style="{StaticResource Switch}" Content="Check for updates"
                                  IsChecked="{Binding CheckForUpdates}" Margin="0,0,28,10"
                                  ToolTip="Looks for a newer version on GitHub when Part Combiner starts. Nothing about you or your files is sent." />
                        <CheckBox Style="{StaticResource Switch}" Content="Explorer right-click menu"
                                  IsChecked="{Binding ShowInExplorerMenu}" Margin="0,0,0,10"
                                  ToolTip="Adds a Part Combiner submenu to the right-click menu of every file and folder: Split into parts, and Combine parts on split parts.&#x0a;It works while Part Combiner is closed. On Windows 11 it's under &quot;Show more options&quot;. Only for your account; no admin needed." />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Footer: status, progress, actions -->
            <Grid Grid.Row="3" Margin="2,16,0,0" Visibility="{Binding IsCombineMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" FontSize="12.5"
                                   ToolTip="{Binding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="12" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Brush.TextFaint}" />
                    </Grid>
                    <ProgressBar Style="{StaticResource Progress.Thin}" Value="{Binding OverallProgress, Mode=OneWay}"
                                 Margin="0,9,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Margin="0,0,8,0" Click="OnCancel"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Button.Primary}" Content="{Binding CombineText}" MinWidth="124"
                            IsEnabled="{Binding CanCombine}" Click="OnCombine" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Shown while files are dragged over the window -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="{DynamicResource Brush.Overlay}">
            <Rectangle Margin="14" RadiusX="16" RadiusY="16" StrokeThickness="2" StrokeDashArray="5 4"
                       Stroke="{DynamicResource Brush.Accent}" Fill="{DynamicResource Brush.AccentSoft}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{Binding DropText}" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
